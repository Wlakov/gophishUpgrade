$ORIGIN training.test.
$TTL 300

@   IN  SOA ns.training.test. hostmaster.training.test. (
        2026082002 ; serial
        3600       ; refresh
        600        ; retry
        604800     ; expire
        300        ; negative cache TTL
)

    IN  NS  ns.training.test.
ns  IN  A   172.30.0.53

; Local mail exchange for reporting messages.
@       IN  MX  10 mail.training.test.
mail    IN  A       172.30.0.10
mailpit IN  A       172.30.0.30

; Mail-authentication records for the isolated training domain.
@       IN  TXT "v=spf1 mx -all"
_dmarc IN  TXT "v=DMARC1; p=none; adkim=r; aspf=r; pct=100"

mail._domainkey IN TXT ( "v=DKIM1; h=sha256; k=rsa; "
